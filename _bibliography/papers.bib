@article{hypergraph_moore_bound,
  title={The Hypergraph Moore Bound},
  author={Bandeira, Afonso S. and Kunisky, Dmitriy and Nizic-Nikolac, Petar and Pesenti, Lucas and Wang, Robert},
  year={2026},
  journal={Available online},
  eprint={2607.14068},
  archivePrefix={arXiv},
  primaryClass={math.CO},
  url={https://arxiv.org/abs/2607.14068},
  arxiv={2607.14068},
  abstract={We prove Feige's conjectured hypergraph Moore bound, which controls the size of the smallest even cover in a $k$-uniform hypergraph in terms of the average density of hyperedges. We give a simple proof of Feige's original conjecture for all $k \geq 3$, with no superfluous polylogarithmic factors. Our method uses colored walks in Kikuchi graphs together with polynomial methods in the even-uniform case, and extends to odd-uniform hypergraphs via an adapted procedure.},
  selected={true}
}

@inproceedings{matrix_chaos_stoc,
author = {Bandeira, Afonso S. and Lucca, Kevin and Nizic-Nikolac, Petar and {van Handel}, Ramon},
title = {Matrix Chaos Inequalities and Chaos of Combinatorial Type},
year = {2025},
isbn = {9798400715105},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3717823.3718238},
doi = {10.1145/3717823.3718238},
arxiv = {2412.18468},
abstract = {Matrix concentration inequalities and their recently discovered sharp counterparts provide powerful tools to bound the spectrum of random matrices whose entries are linear functions of independent random variables. However, in many applications in theoretical computer science and in other areas one encounters more general random matrix models, called matrix chaoses, whose entries are polynomials of independent random variables. Such models have often been studied on a case-by-case basis using ad-hoc methods that can yield suboptimal dimensional factors.   In this paper we provide general matrix concentration inequalities for matrix chaoses, which enable the treatment of such models in a systematic manner. These inequalities are expressed in terms of flattenings of the coefficients of the matrix chaos. We further identify a special family of matrix chaoses of combinatorial type for which the flattening parameters can be computed mechanically by a simple rule. This allows us to provide a unified treatment of and improved bounds for matrix chaoses that arise in a variety of applications, including graph matrices, Khatri-Rao matrices, and matrices that arise in average case analysis of the sum-of-squares hierarchy.},
booktitle = {Proceedings of the 57th Annual ACM Symposium on Theory of Computing},
pages = {795–805},
numpages = {11},
keywords = {Random matrices, matrix concentration inequalities},
location = {Prague, Czechia},
series = {STOC '25},
selected = {true}
}

@article{Hutchcroft_Kent_Nizic-Nikolac_2023,
  title={The bunkbed conjecture holds in the $p\uparrow 1$ limit},
  volume={32},
  DOI={10.1017/S096354832200027X},
  arxiv={2110.00282},
  number={3},
  journal={Combinatorics, Probability and Computing},
  author={Hutchcroft, Tom and Kent, Alexander and Nizic-Nikolac, Petar},
  year={2023},
  pages={363-369},
  abstract={Let $G=(V,E)$ be a countable graph. The Bunkbed graph of $G$ is the product graph $G \times K_2$, which has vertex set $V\times \{0,1\}$ with ``horizontal'' edges inherited from $G$ and additional ``vertical'' edges connecting $(w,0)$ and $(w,1)$ for each $w \in V$. Kasteleyn's Bunkbed conjecture states that for each $u,v \in V$ and $p\in [0,1]$, the vertex $(u,0)$ is at least as likely to be connected to $(v,0)$ as to $(v,1)$ under Bernoulli-$p$ bond percolation on the bunkbed graph. We prove that the conjecture holds in the $p \uparrow 1$ limit in the sense that for each finite graph $G$ there exists $\varepsilon (G)\gt 0$ such that the bunkbed conjecture holds for $p \geqslant 1-\varepsilon (G)$.},
  selected={true}
}
