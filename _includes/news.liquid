{% comment %}
  News items come from _data/news.yml (date, text), newest first.
  On the front page (include.limit) the list sits in a small box that scrolls.
  With include.sidebar it is laid out for the narrow right-hand column instead: the date above
  the text, in a box that fills the rest of that column and scrolls (hidden on phones).
{% endcomment %}
{% assign news = site.data.news %}
{% assign news_size = news | size %}
{% if include.limit and page.announcements.limit %}
  {% assign news_limit = page.announcements.limit %}
{% else %}
  {% assign news_limit = news_size %}
{% endif %}
{% if include.sidebar %}
  <div class="news d-none d-sm-block" style="flex: 1 1 auto; position: relative; min-height: 14rem">
    {% comment %} height: share of the space beside the paper list that the news box takes up {% endcomment %}
    <div style="position: absolute; top: 0; right: 0; left: 0; height: 90%; overflow-y: auto">
      {% for item in news limit: news_limit %}
        <p style="margin-bottom: 0.75rem">
          <strong>{{ item.date }}</strong><br>
          {{ item.text | markdownify | remove: '<p>' | remove: '</p>' }}
        </p>
      {% endfor %}
    </div>
  </div>
{% else %}
  <div class="news">
    {% if news_size > 0 %}
      <div
        class="table-responsive"
        {% if include.limit and page.announcements.scrollable and news_size > 3 %}
          style="max-height: 12rem; margin-bottom: 1.5rem"
        {% endif %}
      >
        <table class="table table-sm table-borderless">
          {% for item in news limit: news_limit %}
            <tr>
              <th scope="row" style="white-space: nowrap">{{ item.date }}</th>
              <td>{{ item.text | markdownify | remove: '<p>' | remove: '</p>' }}</td>
            </tr>
          {% endfor %}
        </table>
      </div>
    {% else %}
      <p>No news so far...</p>
    {% endif %}
  </div>
{% endif %}
